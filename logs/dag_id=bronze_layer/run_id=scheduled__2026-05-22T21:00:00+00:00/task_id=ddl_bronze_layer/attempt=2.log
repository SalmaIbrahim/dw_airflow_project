est_dt TIMESTAMP default NOW()\n);\n\n\n-- datasets\\source_erp\\PX_CAT_G1V2.csv\nCREATE TABLE bronze.erp_px_cat_g1v2 (\nid  VARCHAR(50)\n, cat VARCHAR(50)\n, subcat VARCHAR(50)\n, maintenance VARCHAR(50)\n, ingest_dt TIMESTAMP default NOW()\n);\n\n-------------------------------------------------------","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":410}
